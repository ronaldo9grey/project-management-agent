import { useState, useEffect } from 'react'
import { useAppStore } from '../store'
import { projectApi } from '../api'

interface Project {
  id: number
  name: string
  leader: string
  status: string
  progress: number
  description?: string
  start_date?: string
  end_date?: string
  plan_start_date?: string
  plan_end_date?: string
  budget?: number
  contract_amount?: number
  material_budget?: number
  material_cost?: number
  outsourcing_budget?: number
  outsourcing_cost?: number
  labor_budget?: number
  labor_cost?: number
  indirect_budget?: number
  indirect_cost?: number
  project_category?: string
  project_subject?: string
  implementation_mode?: string
  project_level?: string
  total_hours: number
  total_tasks?: number
  completed_tasks?: number
  progress_formula?: string
  worker_hours: Array<{ name: string; hours: number }>
}

interface Task {
  task_id: string
  task_name: string
  assignee?: string
  start_date?: string
  end_date?: string
  status: string
  progress?: number
  planned_hours?: number
  daily_reports?: Array<{
    report_date: string
    work_content: string
    hours_spent: number
  }>
}

interface KnowledgeDoc {
  id: number
  doc_name: string
  doc_type: string
  project_name: string
  summary: string
  upload_time: string
  uploader_name: string
}

interface KnowledgeStats {
  total_docs: number
  doc_types: number
}

export default function ProjectDetailPage() {
  const { user, logout } = useAppStore()
  const [showUserMenu, setShowUserMenu] = useState(false)
  const [project, setProject] = useState<Project | null>(null)
  const [tasks, setTasks] = useState<Task[]>([])
  const [knowledgeDocs, setKnowledgeDocs] = useState<KnowledgeDoc[]>([])
  const [knowledgeStats, setKnowledgeStats] = useState<KnowledgeStats | null>(null)
  const [taskRisks, setTaskRisks] = useState<any>(null)
  const [expandedTasks, setExpandedTasks] = useState<Set<string>>(new Set())  // 展开的任务ID
  const [expandedPhases, setExpandedPhases] = useState<Set<string>>(new Set(['需求阶段', '设计阶段', '开发阶段', '测试阶段']))  // 默认全部展开
  const [isLoading, setIsLoading] = useState(true)
  
  // Tab切换状态
  const [activeTab, setActiveTab] = useState<'overview' | 'tasks' | 'chat'>('overview')
  
  // 聊天相关状态
  const [chatMessages, setChatMessages] = useState<Array<{role: 'user' | 'assistant', content: string}>>([])
  const [chatInput, setChatInput] = useState('')
  const [isChatLoading, setIsChatLoading] = useState(false)
  
  // 知识库相关状态
  const [showUploadModal, setShowUploadModal] = useState(false)
  const [uploadForm, setUploadForm] = useState({
    doc_name: '',
    doc_type: '需求文档',
    file: null as File | null
  })
  
  // 任务阶段分组
  const getTaskPhase = (taskName: string) => {
    if (taskName.includes('需求') || taskName.includes('调研')) return '需求阶段'
    if (taskName.includes('设计') || taskName.includes('数据库')) return '设计阶段'
    if (taskName.includes('开发') || taskName.includes('接口') || taskName.includes('安全')) return '开发阶段'
    if (taskName.includes('测试') || taskName.includes('联调')) return '测试阶段'
    return '其他'
  }
  
  // 按阶段分组任务
  const groupedTasks = tasks.reduce((acc, task) => {
    const phase = getTaskPhase(task.task_name)
    if (!acc[phase]) acc[phase] = []
    acc[phase].push(task)
    return acc
  }, {} as Record<string, Task[]>)

  // 从URL获取项目ID
  const projectId = parseInt(window.location.pathname.split('/').pop() || '0')

  useEffect(() => {
    loadProjectDetail()
  }, [projectId])

  const loadProjectDetail = async () => {
    setIsLoading(true)
    try {
      // 并行加载项目详情、任务、知识库数据
      const [projectDetail, taskList, taskRiskData] = await Promise.all([
        projectApi.getProjectDetail(projectId),
        projectApi.getTasks(projectId),
        projectApi.getTaskRisks(projectId).catch(() => null)
      ])
      
      setProject(projectDetail)
      setTasks(Array.isArray(taskList) ? taskList : [])
      setTaskRisks(taskRiskData)
      
      // 加载知识库数据
      await loadKnowledgeBase()
    } catch (error) {
      console.error('加载项目详情失败:', error)
    } finally {
      setIsLoading(false)
    }
  }
  
  // 加载知识库数据
  const loadKnowledgeBase = async () => {
    try {
      const { token } = useAppStore.getState()
      if (!token) return
      
      // 获取统计信息
      const statsRes = await fetch(`/api/agent/knowledge/stats?project_id=${projectId}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      })
      
      if (statsRes.status === 401) {
        useAppStore.getState().logout()
        window.location.href = '/agent/login'
        return
      }
      
      if (statsRes.ok) {
        const statsData = await statsRes.json()
        setKnowledgeStats(statsData.data)
      }
      
      // 获取文档列表
      const docsRes = await fetch(`/api/agent/knowledge/list?project_id=${projectId}&limit=10`, {
        headers: { 'Authorization': `Bearer ${token}` }
      })
      
      if (docsRes.status === 401) {
        useAppStore.getState().logout()
        window.location.href = '/agent/login'
        return
      }
      
      if (docsRes.ok) {
        const docsData = await docsRes.json()
        setKnowledgeDocs(docsData.data || [])
      }
    } catch (error) {
      console.error('加载知识库失败:', error)
    }
  }
  
  // 智能问答（新版本 - 聊天窗口）
  const handleChatSend = async () => {
    if (!chatInput.trim() || isChatLoading) return
    
    const userMessage = chatInput.trim()
    setChatInput('')
    
    // 添加用户消息到聊天记录
    setChatMessages(prev => [...prev, { role: 'user', content: userMessage }])
    setIsChatLoading(true)
    
    try {
      const { token } = useAppStore.getState()
      
      if (!token) {
        setChatMessages(prev => [...prev, { role: 'assistant', content: '请先登录' }])
        return
      }
      
      const res = await fetch(`/api/agent/projects/${projectId}/chat`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          message: userMessage,
          session_id: `project_${projectId}`
        })
      })
      
      if (res.status === 401) {
        useAppStore.getState().logout()
        window.location.href = '/agent/login'
        return
      }
      
      const data = await res.json()
      
      if (data.success) {
        setChatMessages(prev => [...prev, { 
          role: 'assistant', 
          content: data.answer || '查询成功' 
        }])
      } else {
        setChatMessages(prev => [...prev, { 
          role: 'assistant', 
          content: data.answer || '查询失败，请稍后重试' 
        }])
      }
    } catch (error) {
      console.error('聊天失败:', error)
      setChatMessages(prev => [...prev, { 
        role: 'assistant', 
        content: '网络错误，请检查网络连接' 
      }])
    } finally {
      setIsChatLoading(false)
    }
  }
  
  // 上传文档
  const handleUpload = async () => {
    if (!uploadForm.doc_name || !uploadForm.file) return
    
    try {
      const { token } = useAppStore.getState()
      const formData = new FormData()
      formData.append('project_id', projectId.toString())
      formData.append('project_name', project?.name || '')
      formData.append('doc_name', uploadForm.doc_name)
      formData.append('doc_type', uploadForm.doc_type)
      formData.append('file', uploadForm.file)
      
      const res = await fetch('/api/agent/knowledge/upload', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`
        },
        body: formData
      })
      
      if (res.ok) {
        const data = await res.json()
        if (data.success) {
          setShowUploadModal(false)
          setUploadForm({ doc_name: '', doc_type: '需求文档', file: null })
          await loadKnowledgeBase()
          alert('文档上传成功！')
        } else {
          alert(data.message || '上传失败')
        }
      } else {
        alert('上传失败，请稍后重试')
      }
    } catch (error) {
      console.error('上传失败:', error)
      alert('上传失败，请检查网络连接')
    }
  }

  const handleLogout = () => {
    logout()
    window.location.href = '/agent/login'
  }

  const getStatusTag = (status: string) => {
    switch (status) {
      case '进行中':
        return <span className="tag tag-success">进行中</span>
      case '规划中':
        return <span className="tag tag-warning">规划中</span>
      case '已完成':
        return <span className="tag tag-info">已完成</span>
      default:
        return <span className="tag tag-default">{status}</span>
    }
  }

  if (isLoading) {
    return (
      <div className="page-container">
        <header className="header">
          <div className="header-content">
            <a href="/agent/projects" className="header-logo">
              <span className="text-xl">⚙️</span>
              <span>项目管家智能体</span>
            </a>
          </div>
        </header>
        <main className="content-wrapper">
          <div className="empty-state" style={{padding: '80px'}}>
            <span className="spinner"></span>
            <p className="text-gray-500 mt-4">加载中...</p>
          </div>
        </main>
      </div>
    )
  }

  if (!project) {
    return (
      <div className="page-container">
        <header className="header">
          <div className="header-content">
            <a href="/agent/projects" className="header-logo">
              <span className="text-xl">⚙️</span>
              <span>项目管家智能体</span>
            </a>
          </div>
        </header>
        <main className="content-wrapper">
          <div className="empty-state">
            <div className="empty-icon">🔍</div>
            <p className="empty-title">项目不存在</p>
            <a href="/agent/projects" className="btn btn-primary mt-4">返回项目列表</a>
          </div>
        </main>
      </div>
    )
  }

  return (
    <div className="page-container">
      {/* 顶部导航 */}
      <header className="header">
        <div className="header-content">
          <div className="header-left">
            <a href="/agent/" className="header-logo">
              <span className="text-xl">⚙️</span>
              <span>项目管家智能体</span>
            </a>
            <nav className="header-nav">
              <a href="/agent/" className="nav-link">个人</a>
              <a href="/agent/daily" className="nav-link">日报</a>
              <a href="/agent/projects" className="nav-link active">项目</a>
              <a href="/agent/chat" className="nav-link">
                问答
              </a>
            </nav>
          </div>
          <div className="header-right">
            <div className="user-menu-wrapper">
              <div className="user-info" onClick={() => setShowUserMenu(!showUserMenu)}>
                <div className="user-avatar">{user?.name?.[0]?.toUpperCase() || 'U'}</div>
                <span className="user-name">{user?.name || '用户'}</span>
                <svg className={`w-4 h-4 text-gray-400 transition-transform ${showUserMenu ? 'rotate-180' : ''}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 9l-7 7-7-7" />
                </svg>
              </div>
              {showUserMenu && (
                <div className="user-dropdown">
                  <div className="user-dropdown-header">
                    <div className="user-avatar-lg">{user?.name?.[0]?.toUpperCase() || 'U'}</div>
                    <div>
                      <div className="font-medium text-gray-900">{user?.name || '用户'}</div>
                      <div className="text-sm text-gray-500">{user?.username || ''}</div>
                    </div>
                  </div>
                  <div className="user-dropdown-divider" />
                  <button className="user-dropdown-item" onClick={handleLogout}>
                    <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                    </svg>
                    退出登录
                  </button>
                </div>
              )}
            </div>
          </div>
        </div>
      </header>

      {/* 主内容 */}
      <main className="content-wrapper">
        {/* 返回按钮 */}
        <a href="/agent/projects" className="back-link">
          <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 19l-7-7 7-7" />
          </svg>
          返回项目列表
        </a>
        
        {/* Tab切换 */}
        <div className="mt-4" style={{display: 'flex', gap: '8px', marginBottom: '16px'}}>
          <button 
            className={`tab-btn ${activeTab === 'overview' ? 'active' : ''}`}
            onClick={() => setActiveTab('overview')}
          >
            📋 项目概况
          </button>
          <button 
            className={`tab-btn ${activeTab === 'tasks' ? 'active' : ''}`}
            onClick={() => setActiveTab('tasks')}
          >
            📝 任务列表
          </button>
          <button 
            className={`tab-btn ${activeTab === 'chat' ? 'active' : ''}`}
            onClick={() => setActiveTab('chat')}
          >
            🤖 智能问答
          </button>
        </div>
        
        {/* Tab内容区域 */}
        {activeTab === 'overview' && (
          <>
            {/* 项目基本信息 + 知识库 */}
            <div className="grid-2 mt-4">
          {/* 左侧：项目信息 */}
          <div className="card">
            <div className="card-header">
              <div className="flex items-center gap-3">
                <h2 className="card-title">{project.name}</h2>
                {getStatusTag(project.status)}
              </div>
            </div>
            <div className="card-body">
              <div className="project-detail-grid">
                <div className="detail-item">
                  <span className="detail-label">项目负责人</span>
                  <span className="detail-value">{project.leader || '未指定'}</span>
                </div>
                <div className="detail-item">
                  <span className="detail-label">项目状态</span>
                  <span className="detail-value">{project.status || '进行中'}</span>
                </div>
                <div className="detail-item">
                  <span className="detail-label">计划周期</span>
                  <span className="detail-value">
                    {project.plan_start_date && project.plan_end_date 
                      ? `${project.plan_start_date} ~ ${project.plan_end_date}`
                      : '未设置'}
                  </span>
                </div>
                <div className="detail-item">
                  <span className="detail-label">任务进度</span>
                  <span className="detail-value">
                    {project.completed_tasks || 0}/{project.total_tasks || 0} 已完成
                  </span>
                </div>
                <div className="detail-item">
                  <span className="detail-label">合同金额</span>
                  <span className="detail-value">{project.contract_amount ? `${project.contract_amount} 万元` : '未设置'}</span>
                </div>
                <div className="detail-item">
                  <span className="detail-label">累计工时</span>
                  <span className="detail-value" style={{color: 'var(--primary)', fontWeight: 600}}>{project.total_hours} 小时</span>
                </div>
              </div>
              
              {/* 成本数据 - 优化布局 */}
              <div className="mt-4" style={{
                padding: '16px', 
                background: 'linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%)', 
                borderRadius: '12px',
                border: '1px solid #bae6fd'
              }}>
                <div className="flex items-center justify-between mb-3">
                  <span className="text-sm font-semibold" style={{color: '#0369a1'}}>💰 成本概览</span>
                  <span className="text-xs" style={{color: '#0284c7'}}>实际 / 预算（万元）</span>
                </div>
                
                <div style={{display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '12px'}}>
                  {/* 材料成本 */}
                  {(project.material_budget || 0) > 0 && (
                    <div style={{
                      padding: '12px', 
                      background: 'linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)', 
                      borderRadius: '8px',
                      border: '1px solid #e2e8f0'
                    }}>
                      <div className="text-xs mb-1" style={{color: '#64748b'}}>📦 材料成本</div>
                      <div className="text-lg font-semibold" style={{color: '#0f172a'}}>
                        {((project.material_cost || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})} / {((project.material_budget || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})}
                      </div>
                      <div className="text-xs mt-1" style={{
                        color: (project.material_cost || 0) > (project.material_budget || 0) ? '#dc2626' : '#16a34a',
                        fontWeight: 500
                      }}>
                        {((project.material_cost || 0) / (project.material_budget || 1) * 100).toFixed(1)}%
                        {(project.material_cost || 0) > (project.material_budget || 0) && ' ⚠️ 超支'}
                      </div>
                    </div>
                  )}
                  
                  {/* 人力成本 */}
                  <div style={{
                    padding: '12px', 
                    background: 'linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)', 
                    borderRadius: '8px',
                    border: '1px solid #e2e8f0'
                  }}>
                    <div className="text-xs mb-1" style={{color: '#64748b'}}>👥 人力成本</div>
                    <div className="text-lg font-semibold" style={{color: '#0f172a'}}>
                      {((project.labor_cost || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})} / {((project.labor_budget || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})}
                    </div>
                    {(project.labor_budget || 0) > 0 && (
                      <div className="text-xs mt-1" style={{
                        color: (project.labor_cost || 0) > (project.labor_budget || 0) ? '#dc2626' : '#16a34a',
                        fontWeight: 500
                      }}>
                        {((project.labor_cost || 0) / (project.labor_budget || 1) * 100).toFixed(1)}%
                        {(project.labor_cost || 0) > (project.labor_budget || 0) && ' ⚠️ 超支'}
                      </div>
                    )}
                  </div>
                  
                  {/* 外包成本 */}
                  {(project.outsourcing_budget || 0) > 0 && (
                    <div style={{
                      padding: '12px', 
                      background: 'linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)', 
                      borderRadius: '8px',
                      border: '1px solid #e2e8f0'
                    }}>
                      <div className="text-xs mb-1" style={{color: '#64748b'}}>🔧 外包成本</div>
                      <div className="text-lg font-semibold" style={{color: '#0f172a'}}>
                        {((project.outsourcing_cost || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})} / {((project.outsourcing_budget || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})}
                      </div>
                      {(project.outsourcing_budget || 0) > 0 && (
                        <div className="text-xs mt-1" style={{
                          color: (project.outsourcing_cost || 0) > (project.outsourcing_budget || 0) ? '#dc2626' : '#16a34a',
                          fontWeight: 500
                        }}>
                          {((project.outsourcing_cost || 0) / (project.outsourcing_budget || 1) * 100).toFixed(1)}%
                        </div>
                      )}
                    </div>
                  )}
                  
                  {/* 间接成本 */}
                  {(project.indirect_budget || 0) > 0 && (
                    <div style={{
                      padding: '12px', 
                      background: 'linear-gradient(135deg, #ffffff 0%, #f8fafc 100%)', 
                      borderRadius: '8px',
                      border: '1px solid #e2e8f0'
                    }}>
                      <div className="text-xs mb-1" style={{color: '#64748b'}}>📊 间接成本</div>
                      <div className="text-lg font-semibold" style={{color: '#0f172a'}}>
                        {((project.indirect_cost || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})} / {((project.indirect_budget || 0) / 10000).toLocaleString('zh-CN', {minimumFractionDigits: 1, maximumFractionDigits: 1})}
                      </div>
                      {(project.indirect_budget || 0) > 0 && (
                        <div className="text-xs mt-1" style={{
                          color: (project.indirect_cost || 0) > (project.indirect_budget || 0) ? '#dc2626' : '#16a34a',
                          fontWeight: 500
                        }}>
                          {((project.indirect_cost || 0) / (project.indirect_budget || 1) * 100).toFixed(1)}%
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </div>
              
              {/* 进度条 + 计算公式 */}
              <div className="mt-6">
                <div className="flex justify-between items-center mb-2">
                  <span className="text-sm text-gray-500">📊 整体进度</span>
                  <span className="text-lg font-bold" style={{color: 'var(--primary)'}}>{project.progress}%</span>
                </div>
                <div className="progress-bar-lg">
                  <div className="progress-bar-fill" style={{ width: `${project.progress}%` }} />
                </div>
                {project.progress_formula && (
                  <div className="mt-2" style={{
                    padding: '8px 12px',
                    background: '#f1f5f9',
                    borderRadius: '6px',
                    fontSize: '12px'
                  }}>
                    <div style={{color: '#64748b', marginBottom: '4px'}}>
                      📐 计算公式：(已完成任务数 / 总任务数 × 100 + 平均任务进度) ÷ 2
                    </div>
                    <div style={{color: '#0f172a', fontFamily: 'monospace'}}>
                      代入数据：{project.progress_formula}
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>

          {/* 右侧：项目知识库 */}
          <div className="card">
            <div className="card-header" style={{display: 'flex', justifyContent: 'space-between', alignItems: 'center'}}>
              <h2 className="card-title">📚 项目知识库</h2>
              <div style={{display: 'flex', alignItems: 'center', gap: '12px'}}>
                {knowledgeStats && (
                  <span className="tag tag-info">{knowledgeStats.total_docs} 个文档</span>
                )}
                <button
                  onClick={() => setShowUploadModal(true)}
                  className="btn btn-outline"
                  style={{
                    padding: '6px 12px',
                    fontSize: '12px'
                  }}
                >
                  📤 上传文档
                </button>
              </div>
            </div>
            <div className="card-body">
              {/* 文档分类统计 */}
              <div className="space-y-3 mb-4">
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  padding: '10px 12px',
                  background: '#f8fafc',
                  borderRadius: '8px',
                  fontSize: '13px'
                }}>
                  <span className="text-gray-600">📁 需求文档</span>
                  <span className="font-medium">{(knowledgeDocs || []).filter(d => d.doc_type === '需求文档').length}</span>
                </div>
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  padding: '10px 12px',
                  background: '#f8fafc',
                  borderRadius: '8px',
                  fontSize: '13px'
                }}>
                  <span className="text-gray-600">📐 设计文档</span>
                  <span className="font-medium">{(knowledgeDocs || []).filter(d => d.doc_type === '设计文档').length}</span>
                </div>
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  padding: '10px 12px',
                  background: '#f8fafc',
                  borderRadius: '8px',
                  fontSize: '13px'
                }}>
                  <span className="text-gray-600">📝 会议纪要</span>
                  <span className="font-medium">{(knowledgeDocs || []).filter(d => d.doc_type === '会议纪要').length}</span>
                </div>
                <div style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  padding: '10px 12px',
                  background: '#f8fafc',
                  borderRadius: '8px',
                  fontSize: '13px'
                }}>
                  <span className="text-gray-600">🔧 技术方案</span>
                  <span className="font-medium">{(knowledgeDocs || []).filter(d => d.doc_type === '技术方案').length}</span>
                </div>
              </div>

              {/* 智能问答卡片 */}
              <div className="card" style={{marginBottom: '16px'}}>
                <div className="card-header">
                  <h3 className="card-title">🔍 智能问答</h3>
                </div>
                <div className="card-body">
                  {/* 问题输入 */}
                  <div style={{display: 'flex', gap: '8px', marginBottom: answer ? '16px' : '0'}}>
                    <input
                      type="text"
                      value={question}
                      onChange={(e) => setQuestion(e.target.value)}
                      placeholder="输入问题，AI 将为您解答..."
                      style={{
                        flex: 1,
                        padding: '12px 16px',
                        border: '1px solid #e5e7eb',
                        borderRadius: '8px',
                        fontSize: '14px',
                        outline: 'none'
                      }}
                      onKeyPress={(e) => {
                        if (e.key === 'Enter') handleQuery()
                      }}
                    />
                    <button
                      onClick={handleQuery}
                      disabled={isQuerying || !question.trim()}
                      className="btn btn-primary"
                      style={{padding: '12px 20px'}}
                    >
                      {isQuerying ? '...' : '发送'}
                    </button>
                  </div>
                  
                  {/* AI 回答 */}
                  {answer && (
                    <div style={{
                      padding: '16px',
                      background: '#f8fafc',
                      borderRadius: '8px',
                      border: '1px solid #e2e8f0'
                    }}>
                      <div style={{
                        fontSize: '12px',
                        fontWeight: '600',
                        color: '#64748b',
                        marginBottom: '8px',
                        display: 'flex',
                        alignItems: 'center',
                        gap: '4px'
                      }}>
                        <span>🤖</span>
                        <span>AI 回答</span>
                      </div>
                      <div style={{
                        fontSize: '14px',
                        lineHeight: '1.7',
                        color: '#1e293b'
                      }}>
                        {answer}
                      </div>
                    </div>
                  )}
                </div>
              </div>

              {/* 最近文档列表 */}
              {(knowledgeDocs?.length || 0) > 0 && (
                <div style={{marginTop: '16px'}}>
                  <div style={{
                    fontSize: '12px',
                    fontWeight: '600',
                    color: '#64748b',
                    marginBottom: '8px'
                  }}>
                    最近文档
                  </div>
                  <div className="space-y-2">
                    {(knowledgeDocs || []).slice(0, 5).map((doc) => (
                      <div key={doc.id} style={{
                        padding: '10px 12px',
                        background: '#f8fafc',
                        borderRadius: '6px',
                        fontSize: '12px'
                      }}>
                        <div style={{display: 'flex', alignItems: 'center', justifyContent: 'space-between'}}>
                          <span style={{color: '#1e293b', fontWeight: '500'}}>{doc.doc_name}</span>
                          <span className="tag tag-default" style={{fontSize: '11px'}}>{doc.doc_type}</span>
                        </div>
                        {doc.summary && (
                          <div style={{color: '#64748b', marginTop: '4px', lineHeight: '1.4'}}>
                            {doc.summary.substring(0, 60)}...
                          </div>
                        )}
                        <div style={{color: '#94a3b8', marginTop: '4px', fontSize: '11px'}}>
                          {doc.upload_time} · {doc.uploader_name}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>

        {/* 上传文档模态框 */}
        {showUploadModal && (
          <div className="modal-overlay" onClick={() => setShowUploadModal(false)}>
            <div className="modal-content" onClick={(e) => e.stopPropagation()} style={{maxWidth: '520px'}}>
              <div className="modal-header">
                <h3 className="modal-title">📤 上传项目文档</h3>
                <button className="modal-close" onClick={() => setShowUploadModal(false)}>×</button>
              </div>
              <div className="modal-body" style={{padding: '24px'}}>
                {/* 项目信息提示 */}
                <div style={{
                  padding: '12px 16px',
                  background: 'linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%)',
                  borderRadius: '8px',
                  marginBottom: '20px',
                  fontSize: '13px'
                }}>
                  <div style={{display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '4px'}}>
                    <span style={{fontSize: '16px'}}>📁</span>
                    <span style={{fontWeight: '600', color: '#0369a1'}}>目标项目</span>
                  </div>
                  <div style={{color: '#0c4a6e', marginLeft: '24px'}}>{project?.name || '未选择项目'}</div>
                </div>

                <div className="form-group">
                  <label className="form-label">
                    <span style={{marginRight: '4px'}}>📄</span>
                    文档名称 <span style={{color: '#ef4444'}}>*</span>
                  </label>
                  <input
                    type="text"
                    className="form-input"
                    value={uploadForm.doc_name}
                    onChange={(e) => setUploadForm({...uploadForm, doc_name: e.target.value})}
                    placeholder="例如：需求调研报告、系统设计方案"
                    style={{fontSize: '14px', padding: '10px 14px'}}
                  />
                </div>

                <div className="form-group">
                  <label className="form-label">
                    <span style={{marginRight: '4px'}}>📂</span>
                    文档类型
                  </label>
                  <select
                    className="form-input"
                    value={uploadForm.doc_type}
                    onChange={(e) => setUploadForm({...uploadForm, doc_type: e.target.value})}
                    style={{fontSize: '14px', padding: '10px 14px'}}
                  >
                    <option value="需求文档">📋 需求文档</option>
                    <option value="设计文档">📐 设计文档</option>
                    <option value="会议纪要">📝 会议纪要</option>
                    <option value="技术方案">🔧 技术方案</option>
                  </select>
                </div>

                <div className="form-group" style={{marginBottom: 0}}>
                  <label className="form-label">
                    <span style={{marginRight: '4px'}}>📎</span>
                    选择文件 <span style={{color: '#ef4444'}}>*</span>
                  </label>
                  <div style={{
                    position: 'relative',
                    padding: '20px',
                    border: '2px dashed #cbd5e1',
                    borderRadius: '8px',
                    background: '#f8fafc',
                    textAlign: 'center',
                    cursor: 'pointer',
                    transition: 'all 0.2s'
                  }}>
                    <input
                      type="file"
                      accept=".pdf,.docx,.doc,.txt,.md"
                      onChange={(e) => setUploadForm({...uploadForm, file: e.target.files?.[0] || null})}
                      style={{
                        position: 'absolute',
                        top: 0,
                        left: 0,
                        width: '100%',
                        height: '100%',
                        opacity: 0,
                        cursor: 'pointer'
                      }}
                    />
                    {uploadForm.file ? (
                      <div>
                        <div style={{fontSize: '24px', marginBottom: '8px'}}>✅</div>
                        <div style={{color: '#059669', fontWeight: '500'}}>{uploadForm.file.name}</div>
                        <div style={{color: '#64748b', fontSize: '12px', marginTop: '4px'}}>
                          {(uploadForm.file.size / 1024).toFixed(1)} KB
                        </div>
                      </div>
                    ) : (
                      <div>
                        <div style={{fontSize: '24px', marginBottom: '8px'}}>📤</div>
                        <div style={{color: '#475569', fontWeight: '500'}}>点击或拖拽文件到此处</div>
                        <div style={{color: '#94a3b8', fontSize: '12px', marginTop: '4px'}}>
                          支持 PDF、Word、Txt、Markdown 格式
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
              <div className="modal-footer" style={{padding: '16px 24px', gap: '12px'}}>
                <button 
                  className="btn btn-outline" 
                  onClick={() => setShowUploadModal(false)}
                  style={{flex: 1, padding: '10px 20px'}}
                >
                  取消
                </button>
                <button 
                  className="btn btn-primary" 
                  onClick={handleUpload}
                  disabled={!uploadForm.doc_name || !uploadForm.file}
                  style={{flex: 2, padding: '10px 20px'}}
                >
                  <span style={{marginRight: '6px'}}>📤</span>
                  上传文档
                </button>
              </div>
            </div>
          </div>
        )}

        {/* 任务风险预警 */}
        {taskRisks && taskRisks.risks && taskRisks.risks.length > 0 && (
          <div className="card mt-6">
            <div className="card-header">
              <h2 className="card-title">⚠️ 任务风险预警</h2>
              <div className="flex items-center gap-2">
                {taskRisks.high_risk_count > 0 && (
                  <span className="tag" style={{background: '#fee2e2', color: '#dc2626'}}>
                    高风险 {taskRisks.high_risk_count}
                  </span>
                )}
                {taskRisks.medium_risk_count > 0 && (
                  <span className="tag" style={{background: '#fef3c7', color: '#d97706'}}>
                    中风险 {taskRisks.medium_risk_count}
                  </span>
                )}
                {taskRisks.low_risk_count > 0 && (
                  <span className="tag" style={{background: '#dbeafe', color: '#2563eb'}}>
                    低风险 {taskRisks.low_risk_count}
                  </span>
                )}
              </div>
            </div>
            <div className="card-body">
              <div className="space-y-3">
                {(taskRisks?.risks || []).map((risk: any, idx: number) => {
                  const getRiskBgColor = (level: string) => {
                    switch (level) {
                      case 'high': return 'rgba(239, 68, 68, 0.1)'
                      case 'medium': return 'rgba(245, 158, 11, 0.1)'
                      case 'low': return 'rgba(34, 197, 94, 0.1)'
                      default: return 'rgba(100, 116, 139, 0.1)'
                    }
                  }
                  
                  const getRiskBorderColor = (level: string) => {
                    switch (level) {
                      case 'high': return '#ef4444'
                      case 'medium': return '#f59e0b'
                      case 'low': return '#22c55e'
                      default: return '#64748b'
                    }
                  }
                  
                  const getRiskIcon = (type: string) => {
                    switch (type) {
                      case 'delayed': return '🔴'
                      case 'delayed_completion': return '🟠'
                      case 'expiring_soon': return '🟡'
                      case 'started_early': return '🟢'
                      case 'not_reported': return '⚠️'
                      case 'starting_soon': return '🔵'
                      default: return '⚪'
                    }
                  }
                  
                  return (
                    <div key={idx} style={{
                      padding: '12px 16px',
                      background: getRiskBgColor(risk.risk_level),
                      borderLeft: `4px solid ${getRiskBorderColor(risk.risk_level)}`,
                      borderRadius: '8px'
                    }}>
                      <div style={{display: 'flex', alignItems: 'center', gap: '12px'}}>
                        <span style={{fontSize: '20px'}}>{getRiskIcon(risk.risk_type)}</span>
                        <div style={{flex: 1}}>
                          <div style={{fontWeight: '500', color: '#1e293b'}}>
                            {risk.task_name}
                          </div>
                          <div style={{fontSize: '13px', color: '#64748b', marginTop: '2px'}}>
                            {risk.message}
                          </div>
                          {risk.plan_period && (
                            <div style={{fontSize: '12px', color: '#94a3b8', marginTop: '4px'}}>
                              📅 计划周期：{risk.plan_period}
                            </div>
                          )}
                        </div>
                        <span style={{
                          padding: '4px 12px',
                          borderRadius: '12px',
                          fontSize: '12px',
                          fontWeight: '500',
                          background: getRiskBorderColor(risk.risk_level),
                          color: 'white'
                        }}>
                          {risk.risk_level === 'high' ? '高' : risk.risk_level === 'medium' ? '中' : '低'}
                        </span>
                      </div>
                    </div>
                  )
                })}
              </div>
            </div>
          </div>
        )}

        {/* 人员工时分布 */}
        {project.worker_hours && project.worker_hours.length > 0 && (
          <div className="card mt-6">
            <div className="card-header">
              <h2 className="card-title">👥 人员工时分布</h2>
            </div>
            <div className="card-body">
              <div className="grid-3">
                {(project.worker_hours || []).map((worker, idx) => (
                  <div key={idx} className="stat-card stat-card-mini">
                    <div className="stat-label">{worker.name}</div>
                    <div className="stat-value-lg" style={{color: 'var(--success)'}}>
                      {worker.hours}<span className="stat-unit">h</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* 项目计划表 */}
        <div className="card mt-6">
          <div className="card-header">
            <h2 className="card-title">📋 项目计划</h2>
            <div className="flex items-center gap-3">
              <span className="text-sm text-gray-500">{(tasks || []).length} 个任务</span>
              <a href={`/agent/plans`} className="btn btn-secondary btn-sm">
                上传计划
              </a>
            </div>
          </div>
          <div className="card-body">
            {(tasks?.length || 0) === 0 ? (
              <div className="empty-state">
                <div className="empty-icon">📅</div>
                <p className="empty-title">暂无计划任务</p>
                <p className="empty-desc">请上传项目计划Excel</p>
              </div>
            ) : (
              <div className="task-tree">
                {Object.entries(groupedTasks || {}).map(([phase, phaseTasks]) => {
                  const isPhaseExpanded = expandedPhases.has(phase)
                  const phaseProgress = phaseTasks.reduce((sum, t) => sum + (t.progress || 0), 0) / (phaseTasks.length || 1)
                  
                  return (
                    <div key={phase} className="task-phase">
                      <div 
                        className="task-phase-header"
                        onClick={() => {
                          const newExpanded = new Set(expandedPhases)
                          if (isPhaseExpanded) {
                            newExpanded.delete(phase)
                          } else {
                            newExpanded.add(phase)
                          }
                          setExpandedPhases(newExpanded)
                        }}
                      >
                        <span style={{
                          marginRight: '8px',
                          transform: isPhaseExpanded ? 'rotate(90deg)' : 'rotate(0deg)',
                          transition: 'transform 0.2s',
                          display: 'inline-block'
                        }}>▶</span>
                        <span style={{fontWeight: '600', color: '#1e293b'}}>{phase}</span>
                        <span className="text-sm text-gray-500" style={{marginLeft: '12px'}}>
                          {(phaseTasks?.length || 0)} 个任务
                        </span>
                        <div className="flex items-center gap-2" style={{marginLeft: 'auto'}}>
                          <div className="progress-bar-sm" style={{width: '100px'}}>
                            <div className="progress-bar-fill" style={{ width: `${phaseProgress}%` }} />
                          </div>
                          <span className="text-sm font-medium">{phaseProgress.toFixed(0)}%</span>
                        </div>
                      </div>
                      
                      {isPhaseExpanded && (
                        <div className="task-phase-items">
                          {(phaseTasks || []).map((task) => {
                            const isTaskExpanded = expandedTasks.has(task.task_id)
                            
                            return (
                              <div key={task.task_id} className="task-item">
                                <div className="task-main">
                                  <div 
                                    className="task-header"
                                    style={{cursor: (task.daily_reports?.length || 0) > 0 ? 'pointer' : 'default'}}
                                    onClick={() => {
                                      if ((task.daily_reports?.length || 0) > 0) {
                                        const newExpanded = new Set(expandedTasks)
                                        if (isTaskExpanded) {
                                          newExpanded.delete(task.task_id)
                                        } else {
                                          newExpanded.add(task.task_id)
                                        }
                                        setExpandedTasks(newExpanded)
                                      }
                                    }}
                                  >
                                    <span className="task-name">
                                      {(task.daily_reports?.length || 0) > 0 && (
                                        <span style={{
                                          marginRight: '6px',
                                          transform: isTaskExpanded ? 'rotate(90deg)' : 'rotate(0deg)',
                                          transition: 'transform 0.2s',
                                          display: 'inline-block',
                                          fontSize: '10px'
                                        }}>▶</span>
                                      )}
                                      {task.task_name}
                                    </span>
                                    <span className={`task-status ${task.status === '已完成' ? 'done' : task.status === '延期' ? 'delayed' : task.status === '进行中' ? 'active' : ''}`}>
                                      {task.status}
                                    </span>
                                  </div>
                                  <div className="task-meta">
                                    {task.assignee && <span>👤 {task.assignee}</span>}
                                    {task.start_date && task.end_date && (
                                      <span>📅 {task.start_date} ~ {task.end_date}</span>
                                    )}
                                    {task.planned_hours && <span>⏱ {task.planned_hours}h</span>}
                                  </div>
                                  <div className="task-progress">
                                    <div className="progress-bar-sm">
                                      <div className="progress-bar-fill" style={{ width: `${task.progress || 0}%` }} />
                                    </div>
                                    <span className="progress-text">{task.progress?.toFixed(1) || 0}%</span>
                                  </div>
                                </div>
                                
                                {isTaskExpanded && (task.daily_reports?.length || 0) > 0 && (
                                  <div className="task-daily-reports">
                                    <div style={{
                                      fontSize: '12px',
                                      color: '#64748b',
                                      marginBottom: '8px',
                                      fontWeight: '500'
                                    }}>
                                      📝 关联日报（{(task.daily_reports?.length || 0)} 条）
                                    </div>
                                    {task.daily_reports && (task.daily_reports || []).map((report, idx) => (
                                      <div key={idx} className="daily-report-item">
                                        <span className="report-date">{report.report_date}</span>
                                        <span className="report-content">{report.work_content}</span>
                                        <span className="report-hours">{report.hours_spent}h</span>
                                      </div>
                                    ))}
                                  </div>
                                )}
                              </div>
                            )
                          })}
                        </div>
                      )}
                    </div>
                  )
                })}
              </div>
            )}
          </div>
        </div>
      </main>

      {/* 移动端底部导航 */}
      <nav className="mobile-nav">
        <a href="/agent/" className="mobile-nav-item">
          <span className="mobile-nav-icon">🏠</span>
          <span>首页</span>
        </a>
        <a href="/agent/daily" className="mobile-nav-item">
          <span className="mobile-nav-icon">📝</span>
          <span>日报</span>
        </a>
        <a href="/agent/projects" className="mobile-nav-item active">
          <span className="mobile-nav-icon">📊</span>
          <span>项目</span>
        </a>
        <a href="/agent/plans" className="mobile-nav-item">
          <span className="mobile-nav-icon">📁</span>
          <span>计划</span>
        </a>
      </nav>
    </div>
  )
}
