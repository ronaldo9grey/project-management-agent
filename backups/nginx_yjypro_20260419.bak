# 上游服务器 - 保持长连接池
upstream agent_backend {
    server 127.0.0.1:3000;
    keepalive 16;
}

# HTTP - 重定向到 HTTPS
server {
    listen 80;
    server_name yjypro.online;
    
    # Let's Encrypt 验证路径
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    # 其他请求重定向到 HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS - 主服务
server {
    listen 443 ssl;
    server_name yjypro.online;
    
    # SSL 证书
    ssl_certificate /etc/letsencrypt/live/yjypro.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yjypro.online/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;

	# 安全响应头
	add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
	add_header X-Frame-Options "SAMEORIGIN" always;
	add_header X-Content-Type-Options "nosniff" always;
	add_header X-XSS-Protection "1; mode=block" always;
    
    client_max_body_size 50M;
    
    # 性能优化 - 增加 keepalive 超时
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 120s;
    keepalive_requests 1000;
    types_hash_max_size 2048;
    
    # 缓冲配置
    output_buffers 1 16k;
    postpone_output 1460;
    
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    
    location = /agent/index.html {
        alias /var/www/project-agent/frontend/index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
    
    # 智能体前端
    location /agent {
        alias /var/www/project-agent/frontend/;
        try_files $uri $uri/ /agent/index.html;
        index index.html;
        
        # 静态资源缓存策略
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            expires 7d;
            add_header Cache-Control "public, max-age=604800";
        }
        
        # HTML 和 manifest 不缓存
        location ~* \.(html|json)$ {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }
    }

    # 智能体API - 使用 upstream keepalive
    location /agent-api/ {
        proxy_pass http://agent_backend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        chunked_transfer_encoding on;
    }

    # 智能体后端API - 使用 upstream keepalive
    location /api/agent/ {
        proxy_pass http://agent_backend/api/agent/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection '';
        proxy_read_timeout 300s;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_buffering off;
        chunked_transfer_encoding on;
    }
    
    # 根路径重定向到 /agent
    location = / {
        return 301 /agent/;
    }
}
